# APP / AUTH — production is fail-closed. Use --demo for isolated, non-sending local acceptance.
APP_MODE=production
APP_PUBLIC_URL=https://jobs.example.com
AUTH_SOCIAL_PROVIDER=google
EXTENSION_IDS=
DB_POOL_SIZE=3
WORKER_POLL_MS=2000

# DATABASE — remote Supabase direct/session connection, not transaction pooler.
SUPABASE_DB_URL=jdbc:postgresql://db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# SUPABASE / STORAGE — private bucket and asymmetric Auth signing keys.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=resumes

# ENCRYPTION — base64-encoded 32 cryptographically random bytes; back up separately.
ENCRYPTION_MASTER_KEY=

# LLM — only the selected provider needs credentials and all three model IDs.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=4096
LLM_DAILY_REQUEST_LIMIT=50
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=
GEMINI_MODEL_MEDIUM=
GEMINI_MODEL_HIGH=
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=
OPENAI_MODEL_MEDIUM=
OPENAI_MODEL_HIGH=
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
ANTHROPIC_API_KEY=
CLAUDE_MODEL_CHEAP=
CLAUDE_MODEL_MEDIUM=
CLAUDE_MODEL_HIGH=
CLAUDE_INPUT_COST_PER_MILLION=
CLAUDE_OUTPUT_COST_PER_MILLION=

# WEB SEARCH — optional; required only when public recruiter research is requested.
BRAVE_SEARCH_API_KEY=

# GMAIL — optional confidential web OAuth client; enable Gmail API in Google Cloud.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# MICROSOFT — optional confidential web OAuth client with delegated Mail.Send/User.Read.
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# MATCHING — candidate,freshness,referral,reachability,company,salary (sum=1).
RANKING_WEIGHTS=0.40,0.20,0.15,0.10,0.10,0.05

# AWS / EC2_DEPLOYMENT — deployment uses your existing SSH agent/key; no AWS key in containers.
EC2_HOST=
EC2_USER=ubuntu
EC2_DEPLOY_DIR=/opt/myjobai
IMAGE_TAG=local

# DOMAIN / TLS — operator-provisioned files readable by Nginx UID/GID 101.
TLS_DIRECTORY=./.local/tls
ACME_DIRECTORY=./.local/acme
